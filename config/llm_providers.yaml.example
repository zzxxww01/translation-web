providers:
  # relay: 中转为 true、官方为 false。中转上的模型失败时，先降级到官方组（同家族优先），再试中转上的其他模型。
  # fallback: false 的模型只在被直接指定时使用，不会被别的任务当兜底。
  gemini-official:
    type: gemini
    relay: false
    name: Gemini 官方 API
    description: Google 官方 API，稳定可靠
    group_priority: 2
    network:
      proxy_mode: disabled
    api_keys:
    - key: ${GEMINI_API_KEY}
      priority: 1
      name: 主 Key
    - key: ${GEMINI_BACKUP_API_KEY}
      priority: 2
      name: 备用 Key
    rate_limit:
      max_concurrent: 2
      requests_per_minute: 60
    models:
    - alias: gemini-flash-fallback
      real_model: gemini-3.8-flash
      name: Gemini 3.8 Flash
      description: 快速低成本
      priority: 2
      supports_thinking: false
      config:
        temperature: 0.7
        max_tokens: 32768
        timeout: 120
    - alias: gemini-pro-fallback
      real_model: gemini-3.1-pro-preview
      name: Gemini 3.1 Pro Preview
      description: 平衡质量与成本
      priority: 2
      supports_thinking: true
      config:
        temperature: 0.7
        max_tokens: 32768
        timeout: 120
    - alias: gemini-preview-fallback
      real_model: gemini-3.1-pro-preview
      name: Gemini 3.1 Pro Preview
      description: 预览版更强能力
      priority: 2
      supports_thinking: true
      config:
        temperature: 0.7
        max_tokens: 32768
        timeout: 120
    - alias: gemini-official-argon
      real_model: gemini-4-argon
      name: Gemini 4 Argon
      description: 预览版，质量最好；用于帖子优化、标题与话题标签
      priority: 3
      supports_thinking: false
      fallback: false
      config:
        temperature: 0.7
        max_tokens: 32768
        timeout: 120
    retry_config:
      max_retries: 5
      base_delay: 0.5
      max_delay: 16.0
      exponential_backoff: true
  vectorengine-relay:
    type: vectorengine
    relay: true
    name: RelayRouter 中转
    description: 高性价比中转服务
    group_priority: 1
    network:
      proxy_mode: disabled
    api_keys:
    - key: ${VECTORENGINE_API_KEY}
      priority: 1
      name: 主 Key
    - key: ${VECTORENGINE_BACKUP_API_KEY}
      priority: 2
      name: 备用 Key
    base_url: ${VECTORENGINE_BASE_URL}
    rate_limit:
      max_concurrent: 100
      requests_per_minute: 1000
    models:
    - alias: deepseek-v3
      real_model: deepseek-v4.1-flash
      name: DeepSeek V4.1 Flash
      description: 高性价比推理模型
      priority: 1
      supports_thinking: true
      config:
        temperature: 0.7
        max_tokens: 8192
        timeout: 120
    - alias: qwen-plus
      real_model: qwen3.6-plus
      name: Qwen 3.6 Plus
      description: 通义千问；18~25 秒且输出上限小时会返回空，不作兜底
      priority: 2
      supports_thinking: false
      fallback: false
      config:
        temperature: 0.7
        max_tokens: 8192
        timeout: 120
    - alias: grok-4-1-fast-non-reasoning
      real_model: grok-4.7
      name: Grok 4.7
      description: xAI 模型
      priority: 3
      supports_thinking: false
      config:
        temperature: 0.7
        max_tokens: 8192
        timeout: 120
    - alias: gemini-flash
      real_model: gemini-3.8-flash
      name: Gemini 3.8 Flash
      description: 快速低成本
      priority: 2
      supports_thinking: false
      config:
        temperature: 0.7
        max_tokens: 32768
        timeout: 120
    - alias: gemini-pro
      real_model: gemini-3.8-flash
      name: Gemini 3.8 Flash
      description: 平衡质量与成本
      priority: 2
      supports_thinking: true
      config:
        temperature: 0.7
        max_tokens: 32768
        timeout: 120
    - alias: gemini-preview
      real_model: gemini-3.8-flash
      name: Gemini 3.8 Flash
      description: 预览版更强能力
      priority: 2
      supports_thinking: true
      config:
        temperature: 0.7
        max_tokens: 32768
        timeout: 120
    retry_config:
      max_retries: 3
      base_delay: 1.0
      max_delay: 10.0
      exponential_backoff: true
  deepseek-official:
    type: vectorengine  # OpenAI 兼容接口，复用同一套调用代码
    relay: false
    name: DeepSeek 官方 API
    description: DeepSeek 官方；中转 DeepSeek 失败时优先降级到这里
    group_priority: 2
    network:
      proxy_mode: disabled
    api_keys:
    - key: ${DEEPSEEK_API_KEY}
      priority: 1
      name: 主 Key
    base_url: https://api.deepseek.com/v1
    rate_limit:
      max_concurrent: 20
      requests_per_minute: 600
    models:
    - alias: deepseek-flash-official
      real_model: deepseek-flash
      name: DeepSeek Flash
      description: 2026-10-24 盲评 4.21，与 3.8-flash 相当
      priority: 1
      supports_thinking: false
      config:
        temperature: 0.7
        max_tokens: 8192
        timeout: 120
    # deepseek-v4-pro 盲评 3.74 且慢一倍，不配置。
    retry_config:
      max_retries: 3
      base_delay: 1.0
      max_delay: 10.0
      exponential_backoff: true
fallback_rules:
  within_provider:
    enabled: true
    strategy: key_first
  cross_provider:
    enabled: true
    model_priority_keywords:
    - claude
    - gemini
    - gpt
    - deepseek
    - kimi
    - doubao
    - qwen
task_defaults:
  # 2026-10-24 盲评：3.8-flash 4.35 分，argon 4.65，2.5-flash 3.26。长文与帖子翻译用 3.8-flash
  # （中转优先，中转不可用时落到官方 gemini-flash-fallback，同为 3.8-flash）。
  longform: gemini-flash
  post: gemini-flash
  post_optimize: gemini-official-argon
  analysis: deepseek-v3
  # 标题与话题标签：经生产路径盲评，argon 与 3.1 Pro 打平（标题 3.81 vs 3.85，话题标签 3.92 vs 3.75），
  # argon 更快，且全部守住 20 字。Explicit user model overrides still apply.
  title: gemini-official-argon
  metadata: deepseek-v3
  slack: gemini-pro
