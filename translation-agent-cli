#!/usr/bin/env bash
# Muse 自动化 CLI（src/cli/automation.py）。~/bin/translation-agent 软链接到线上发布目录里的这个文件。
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export PYTHONPATH="$ROOT_DIR${PYTHONPATH:+:$PYTHONPATH}"
cd "$ROOT_DIR"

if [[ -x "$ROOT_DIR/.venv/bin/python" ]]; then
    exec "$ROOT_DIR/.venv/bin/python" -m src.cli.automation "$@"
fi

exec python3 -m src.cli.automation "$@"
