# ----------------------------
# Python
# ----------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# ----------------------------
# Environment / secrets
# ----------------------------
.env
.env.*
!.env.example

# config/llm_providers.yaml 不在此列：它只用 ${VAR} 占位符引用 .env，
# 不含明文密钥，纳入版本控制才能让各机器共享 provider/模型定义
# （否则 translation_models.yaml 引用的别名在别的机器上无定义，
# create_llm_provider 不报错而是静默回落到 Gemini）。
# 本地覆盖配置仍然排除——按约定它可能直接写明文密钥。
config/*.local.yaml

# ----------------------------
# Runtime data (DO NOT publish)
# ----------------------------
# Exclude all project data (user translation work)
projects/*
!projects/.gitkeep
conversations/
data/
*.db
*.sqlite
*.sqlite3

# ----------------------------
# Frontend build artifacts
# ----------------------------
web/frontend/node_modules/
web/frontend/dist/
web/frontend/.next/
web/frontend/out/
web/frontend/lint-report.json

# ----------------------------
# Test / temporary artifacts
# ----------------------------
.pytest_cache/
.tmp_testdata/
.coverage
htmlcov/
tests/.tmp/
tests/temp/
tests/**/__pycache__/

# ----------------------------
# IDE / local tooling
# ----------------------------
.vscode/
.idea/
.claude/
.antigravity/
*.sublime-project
*.sublime-workspace

# ----------------------------
# Logs / temp
# ----------------------------
*.log
logs/
*.tmp
*.swp
*.swo
*~

# ----------------------------
# OS files
# ----------------------------
.DS_Store
Thumbs.db
desktop.ini

# ----------------------------
# Scratch / analysis artifacts (not part of the codebase)
# ----------------------------
tmp_findings_*.json
tmp_findings_*.py
translation-agent-analysis/

# 词表升版脚本留下的本地备份（scripts/sync_glossary_to_skill.py 等），
# 不应进版本控制——真正的历史在 git 里。
# *.bak-* 覆盖带时间戳的变体，如 global_glossary_semi.bak-20260809-135207.json：
# 这类文件名以 .json 收尾，*.bak 和 *.bak-v* 都匹配不到。
*.bak
*.bak-*
