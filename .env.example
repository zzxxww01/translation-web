# Translation Agent - 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ============ LLM 配置 ============
# Gemini API Key（必填）
# LLM_PROVIDER=gemini

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BACKUP_API_KEY=your_gemini_backup_api_key_here

# Gemini 代理配置（按需填写）
# GEMINI_HTTP_PROXY=http://127.0.0.1:7890
# GEMINI_HTTPS_PROXY=http://127.0.0.1:7890
# GEMINI_NO_PROXY=localhost,127.0.0.1

# VectorEngine 兼容配置（OpenAI 兼容中转，目前接 RelayRouter）
VECTORENGINE_API_KEY=your_vectorengine_api_key_here
VECTORENGINE_BACKUP_API_KEY=your_vectorengine_backup_api_key_here
VECTORENGINE_BASE_URL=https://api.relayrouter.app/v1

# DeepSeek 官方（OpenAI 兼容，base https://api.deepseek.com/v1）；中转 DeepSeek 失败时优先降级到这里
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Gemini 模型配置（可选）
# 1) 配置别名对应的真实模型名（钉具体版本，别用 *-latest：浮动别名会让供应商
#    换代时质量无声漂移，代码没改译文风格却变了）
# GEMINI_FLASH_MODEL=gemini-3.8-flash
# GEMINI_PRO_MODEL=gemini-3.1-pro-preview
# GEMINI_PREVIEW_MODEL=gemini-3.1-pro-preview
# 2) 选择默认主模型与备用模型（可填 alias 或真实模型名）
# GEMINI_MODEL=pro
# GEMINI_BACKUP_MODEL=flash
# GEMINI_TEMPERATURE=0.7
# GEMINI_MAX_TOKENS=8192
#
# Request timeout (seconds)
# GEMINI_TIMEOUT=120

# OpenAI 官方直连（仅显式选择 gpt-6.1-sol 时使用，见 docs/openai-official.md）
# OPENAI_API_KEY=your_openai_api_key_here

# ============ 服务器配置 ============
# API_HOST=127.0.0.1
# API_PORT=54321
# DEBUG=false

# CORS 配置（生产环境必须配置）
# CORS_ORIGINS=http://localhost:54321,http://127.0.0.1:54321

# 安全配置（公网环境必须）
# ALLOW_CUSTOM_PROMPTS=false  # 禁用自定义 prompt（防止注入）
# 访问控制不在应用层做：线上由 Cloudflare Tunnel + Nginx 负责。

# ============ 存储路径 ============
# PROJECTS_PATH=projects
# GLOSSARY_PATH=glossary

# ============ 日志配置 ============
# LOG_LEVEL=INFO
# LOG_FORMAT=json
# LOG_FILE=logs/app.log

# ============ 翻译配置 ============
# 翻译 prompt 风格：original（标准，保留完整推理）/ simplified（精简，紧凑中文）
# TRANSLATION_PROMPT_STYLE=original

# 长文分阶段模型在 config/translation_models.yaml 里配置（Phase 0 Grok 预扫描、Phase 1 Gemini Flash 初译、
# Phase 2 官方 argon 精修、Phase 3 Gemini 质量报告）；用户可通过 API 的 model 参数覆盖为单一模型。

# ============ Substack 下载（scripts/fetch_substack.py） ============
# 自己订阅账号的登录 cookie，用于下载付费文章 HTML。按域名生效，
# 只需登录会话那一项：自定义域名（如 newsletter.semianalysis.com）叫 connect.sid，
# *.substack.com 叫 substack.sid。
# SUBSTACK_COOKIE='connect.sid=xxx'
